<!-- Dark text: used by the White style. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.Foreground" Color="#FF1C1C1E" />
    <SolidColorBrush x:Key="Brush.ForegroundSecondary" Color="#991C1C1E" />
    <SolidColorBrush x:Key="Brush.TileHover" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.Separator" Color="#22000000" />
</ResourceDictionary>
