<Window x:Class="Prismbar.Popovers.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True" WindowStyle="None" Topmost="True" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" Background="Transparent"
        ShowActivated="True" Opacity="0"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Font.Ui}" FontSize="12" Foreground="{DynamicResource Brush.Foreground}">
    <!-- Margin leaves room for the drop shadow. -->
    <Grid x:Name="Root" Margin="16">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Grid.Effect>
            <DropShadowEffect BlurRadius="18" Opacity="0.35" ShadowDepth="2" Direction="270" />
        </Grid.Effect>
        <!-- Glass layer: Prismbar.Glass inserts a LiquidGlass here for glass styles. -->
        <Grid x:Name="GlassLayer" />
        <Border x:Name="Surface" CornerRadius="16" BorderThickness="1" />
        <Border x:Name="ContentBorder" Padding="14" MinWidth="220" MaxWidth="420">
            <ContentPresenter x:Name="Presenter" />
        </Border>
    </Grid>
</Window>
