<UserControl x:Class="Prismbar.Widgets.ClockPopover"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Prismbar.Controls"
             Width="260">
    <StackPanel>
        <c:PopoverHeader Title="{DynamicResource Widget.clock.Name}" />
        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Command="{Binding NextMonthCommand}">
                <c:IconPath Icon="chevron-up" Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                    <c:IconPath.RenderTransform><RotateTransform Angle="90" /></c:IconPath.RenderTransform>
                </c:IconPath>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Command="{Binding PreviousMonthCommand}">
                <c:IconPath Icon="chevron-up" Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                    <c:IconPath.RenderTransform><RotateTransform Angle="-90" /></c:IconPath.RenderTransform>
                </c:IconPath>
            </Button>
            <TextBlock Style="{StaticResource Text.Status}" Text="{Binding MonthTitle}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding WeekdayNames}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding}" HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,4" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding MonthDays}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Height="28">
                        <Ellipse x:Name="TodayDot" Width="26" Height="26" Fill="{StaticResource Brush.Accent}" Visibility="Collapsed" />
                        <TextBlock x:Name="Num" Style="{StaticResource Text.Primary}" Text="{Binding Day}" HorizontalAlignment="Center" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding InMonth}" Value="False">
                            <Setter TargetName="Num" Property="Opacity" Value="0.35" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter TargetName="TodayDot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Num" Property="Foreground" Value="White" />
                            <Setter TargetName="Num" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Style="{StaticResource Separator.Popover}" />
        <TextBlock Style="{StaticResource Text.Secondary}" Text="{DynamicResource Widget.clock.Upcoming}" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding UpcomingEvents}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,3">
                        <Border DockPanel.Dock="Left" Width="3" CornerRadius="1.5" Margin="0,0,8,0" Background="{Binding ColorHex}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Primary}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Text.Secondary}" FontSize="11">
                            <Run Text="{Binding Start.LocalDateTime, StringFormat={}{0:ddd d MMM, t}, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource Text.Secondary}" Text="{DynamicResource Widget.clock.NoEvents}"
                   Visibility="{Binding HasEvents, Converter={x:Static c:InverseBoolToVisibilityConverter.Instance}}" />
        <Border Style="{StaticResource Separator.Popover}" />
        <Button Style="{StaticResource Link}" Content="{DynamicResource Widget.clock.AdjustDateTime}" Command="{Binding OpenDateTimeSettingsCommand}" />
    </StackPanel>
</UserControl>
