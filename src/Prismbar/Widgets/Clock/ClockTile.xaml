<UserControl x:Class="Prismbar.Widgets.ClockTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" Margin="2,0">
        <TextBlock Style="{StaticResource Text.Status}" Text="{Binding TimeText}" HorizontalAlignment="Right" />
        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding DateText}" HorizontalAlignment="Right" FontSize="11" />
    </StackPanel>
</UserControl>
